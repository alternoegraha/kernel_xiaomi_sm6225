CONFIG_LOCALVERSION="-Sakayori"
CONFIG_CMDLINE="cgroup_disable=pressure"
CONFIG_FAKE_UNAME_5_10=y

# Device specific configs
CONFIG_TARGET_PROJECT_C3Q=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_CMA_SIZE_MBYTES=20
CONFIG_LOG_BUF_SHIFT=21
CONFIG_LOG_CPU_MAX_BUF_SHIFT=0
CONFIG_ARM_ARCH_TIMER_VCT_ACCESS=y
CONFIG_LTO_CLANG=y
CONFIG_TLS=y
CONFIG_NET_ACT_CONNMARK=y
CONFIG_PM_WAKELOCKS_GC=y
CONFIG_ANT_CHECK=y
CONFIG_ANT_CHECK_DIV=y
CONFIG_INPUT_FINGERPRINT=y
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
CONFIG_TOUCHSCREEN_FTS_SPI=y
CONFIG_FINGERPRINT_FPC1020=y
CONFIG_SILEAD_FP_PLATFORM=y
CONFIG_SMB1351_USB_CHARGER=y
CONFIG_SH36610X_BATTERY=y
CONFIG_LCD_BIAS=y
CONFIG_LCD_BKL=y
CONFIG_WUSB3801_DEBUG=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_QCA_CLD_WLAN=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_DRM_PANEL=y
CONFIG_FB=y

# Compiler
CONFIG_FRAME_WARN=0

# Perf configs
CONFIG_IRQ_SBALANCE=y
CONFIG_IRQ_SBALANCE_POLL_MSEC=20000
CONFIG_IRQ_SBALANCE_THRESH=1024
CONFIG_SBALANCE_EXCLUDE_CPUS="3,7"
CONFIG_LITTLE_CPU_MASK=15
CONFIG_BIG_CPU_MASK=240
CONFIG_ANDROID_SIMPLE_LMK=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=20
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_SCHED_CASS=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# PSTORE
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_LAST_KMSG=y

# Disabled configs
# CONFIG_CPU_BOOST is not set
